#!/bin/bash
CONF="$HOME/.config/featheros/appearance.conf"
mkdir -p "$HOME/.config/featheros" "$HOME/.config/gtk-3.0"
sacc=$(grep '^accent=' "$CONF" 2>/dev/null | cut -d= -f2)
smode=$(grep '^mode=' "$CONF" 2>/dev/null | cut -d= -f2)
ACC="${1:-${sacc:-#2E6F95}}"
MODE="${2:-${smode:-light}}"
[[ "$ACC" =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo "Accent must look like #2E6F95"; exit 1; }
[[ "$MODE" == dark || "$MODE" == light ]] || MODE=light
printf '[appearance]\naccent=%s\nmode=%s\n' "$ACC" "$MODE" > "$CONF"
cat > "$HOME/.config/gtk-3.0/gtk.css" <<CSS
@define-color accent_color $ACC;
@define-color theme_selected_bg_color $ACC;
@define-color selected_bg_color $ACC;
@define-color theme_selected_fg_color #ffffff;
@define-color selected_fg_color #ffffff;
.xfce4-panel.background { background-color: mix(#0b1218, $ACC, 0.28); color: #ffffff; }
button { min-height: 34px; border-radius: 8px; padding: 4px 12px; }
entry, spinbutton { min-height: 34px; border-radius: 8px; }
menuitem { min-height: 38px; }
scale trough { min-height: 8px; border-radius: 4px; }
scale slider { min-height: 24px; min-width: 24px; border-radius: 12px; }
CSS
if [ "$MODE" = dark ]; then T=Adwaita-dark; ICONS=Papirus-Dark; else T=Adwaita; ICONS=Papirus; fi
xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "$ICONS" 2>/dev/null
xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s HighContrast 2>/dev/null
sleep 0.4
xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$T" 2>/dev/null
