#!/bin/bash
. /usr/local/bin/featheros-barlib
[ "$(bar_get ram 1)" = 1 ] || { echo "<txt></txt>"; exit 0; }
read -r total avail < <(awk '/^MemTotal/{t=$2}/^MemAvailable/{a=$2}END{print t,a}' /proc/meminfo)
used=$(( (total - avail) / 1024 ))
pct=$(( (total - avail) * 100 / total ))
printf '<txt> RAM %d MB </txt>\n<bar>%d</bar>\n<txtclick>xfce4-taskmanager</txtclick>\n<barclick>xfce4-taskmanager</barclick>\n<tool>%d%% of %d MB in use. Tap for the task manager.</tool>\n' "$used" "$pct" "$pct" $(( total / 1024 ))
