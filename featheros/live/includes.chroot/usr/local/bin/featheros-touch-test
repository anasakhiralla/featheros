#!/usr/bin/env python3
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk

class T(Gtk.Window):
    def __init__(self):
        super().__init__(title='Multi-touch test')
        self.set_default_size(520, 420)
        self.now = 0
        self.most = 0
        self.scale = 1.0
        self.da = Gtk.DrawingArea()
        self.da.add_events(Gdk.EventMask.TOUCH_MASK)
        self.da.connect('draw', self.draw)
        self.da.connect('touch-event', self.on_touch)
        self.zoom = Gtk.GestureZoom.new(self.da)
        self.zoom.connect('scale-changed', self.on_scale)
        self.add(self.da)
        self.connect('destroy', Gtk.main_quit)
        self.show_all()

    def on_touch(self, w, ev):
        if ev.type == Gdk.EventType.TOUCH_BEGIN:
            self.now += 1
            self.most = max(self.most, self.now)
        elif ev.type in (Gdk.EventType.TOUCH_END, Gdk.EventType.TOUCH_CANCEL):
            self.now = max(0, self.now - 1)
        self.da.queue_draw()
        return True

    def on_scale(self, g, s):
        self.scale = s
        self.da.queue_draw()

    def draw(self, w, cr):
        a = w.get_allocation()
        cr.set_source_rgb(0.08, 0.14, 0.18)
        cr.paint()
        cr.set_source_rgb(1, 1, 1)
        cr.set_font_size(26)
        lines = ['Put 1, 2, 3 or more fingers on the screen',
                 'Fingers now: %d' % self.now,
                 'Most at once: %d' % self.most,
                 'Pinch scale: %.2f' % self.scale]
        y = a.height / 2 - 60
        for l in lines:
            cr.move_to(24, y)
            cr.show_text(l)
            y += 44
        return False

T()
Gtk.main()
