#!/bin/sh
set -e
chmod 755 /usr/local/bin/featheros-* 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
dconf update 2>/dev/null || true
systemctl enable featheros-updates.timer 2>/dev/null || true
systemctl enable NetworkManager bluetooth zramswap 2>/dev/null || true
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="FeatherOS (Debian 13)"/' /etc/os-release 2>/dev/null || true
